<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800" fill="none">

  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0L0 0 0 40" stroke="#ffffff" stroke-width="1" opacity="0.06"/>
    </pattern>

    <radialGradient id="glow">
      <stop offset="0%" stop-color="#34d399" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
    </radialGradient>

    <radialGradient id="brain">
      <stop offset="0%" stop-color="#d4d4d8"/>
      <stop offset="45%" stop-color="#71717a"/>
      <stop offset="75%" stop-color="#27272a"/>
      <stop offset="100%" stop-color="#09090b"/>
    </radialGradient>

    <radialGradient id="tumorGlow">
      <stop offset="0%" stop-color="#34d399" stop-opacity="0.8"/>
      <stop offset="40%" stop-color="#34d399" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
    </radialGradient>

    <filter id="blur">
      <feGaussianBlur stdDeviation="12"/>
    </filter>

    <clipPath id="brainClip">
      <ellipse cx="600" cy="330" rx="145" ry="170"/>
    </clipPath>
  </defs>

  <!-- Background -->
  <rect width="1200" height="800" fill="#09090b"/>
  <rect width="1200" height="800" fill="url(#grid)"/>
  <circle cx="600" cy="330" r="400" fill="url(#glow)"/>

  <!-- Header -->
  <text x="70" y="65"
        font-family="monospace"
        font-size="13"
        fill="#34d399"
        letter-spacing="3">
    AI / MEDICAL IMAGING
  </text>

  <line x1="70" y1="85" x2="1130" y2="85"
        stroke="#27272a"/>

  <!-- MRI Scan Frame -->
  <rect x="455" y="130"
        width="290"
        height="370"
        rx="10"
        stroke="#34d399"
        stroke-width="2"
        opacity="0.3"/>

  <!-- Scan corners -->
  <path d="M455 170V130H490"
        stroke="#34d399"
        stroke-width="3"/>

  <path d="M710 130H745V170"
        stroke="#34d399"
        stroke-width="3"/>

  <path d="M455 460V500H490"
        stroke="#34d399"
        stroke-width="3"/>

  <path d="M710 500H745V460"
        stroke="#34d399"
        stroke-width="3"/>

  <!-- Brain -->
  <ellipse cx="600" cy="330"
           rx="145"
           ry="170"
           fill="url(#brain)"
           stroke="#a1a1aa"
           stroke-width="2"/>

  <!-- Brain structure -->
  <g clip-path="url(#brainClip)"
     fill="none"
     stroke="#e4e4e7"
     opacity="0.25">

    <path d="M480 270
             C530 235 565 275 600 300
             C635 325 670 275 720 250"/>

    <path d="M475 320
             C525 285 565 325 600 350
             C635 375 675 325 725 295"/>

    <path d="M480 375
             C530 340 565 375 600 400
             C635 425 675 375 720 350"/>

    <path d="M530 175
             C560 235 545 285 575 340
             C600 385 570 435 550 485"/>

    <path d="M670 175
             C640 235 655 285 625 340
             C600 385 630 435 650 485"/>

    <path d="M600 165
             C580 220 615 265 600 315
             C585 360 615 405 600 465"/>
  </g>

  <!-- Tumor detection -->
  <circle cx="650" cy="310"
          r="65"
          fill="url(#tumorGlow)"
          filter="url(#blur)"/>

  <circle cx="650" cy="310"
          r="13"
          fill="#34d399"/>

  <circle cx="650" cy="310"
          r="30"
          stroke="#34d399"
          stroke-width="2"
          stroke-dasharray="6 6"/>

  <!-- Detection line -->
  <line x1="670" y1="295"
        x2="805" y2="220"
        stroke="#34d399"
        stroke-width="2"/>

  <circle cx="805" cy="220"
          r="4"
          fill="#34d399"/>

  <text x="820" y="215"
        font-family="monospace"
        font-size="12"
        fill="#34d399"
        letter-spacing="1">
    DETECTED REGION
  </text>

  <text x="820" y="237"
        font-family="monospace"
        font-size="11"
        fill="#71717a">
    TUMOR CLASSIFICATION
  </text>

  <!-- CNN Models -->
  <text x="600" y="555"
        font-family="monospace"
        font-size="11"
        fill="#52525b"
        text-anchor="middle"
        letter-spacing="2">
    MODEL EVALUATION PIPELINE
  </text>

  <!-- CNN -->
  <rect x="130" y="580"
        width="150" height="48"
        rx="8"
        fill="#111827"
        stroke="#34d399"
        stroke-opacity="0.5"/>

  <text x="205" y="610"
        font-family="system-ui, sans-serif"
        font-size="14"
        font-weight="700"
        fill="#ffffff"
        text-anchor="middle">
    CNN
  </text>

  <!-- VGG16 -->
  <rect x="305" y="580"
        width="150" height="48"
        rx="8"
        fill="#111827"
        stroke="#34d399"
        stroke-opacity="0.5"/>

  <text x="380" y="610"
        font-family="system-ui, sans-serif"
        font-size="14"
        font-weight="700"
        fill="#ffffff"
        text-anchor="middle">
    VGG16
  </text>

  <!-- VGG19 -->
  <rect x="480" y="580"
        width="150" height="48"
        rx="8"
        fill="#111827"
        stroke="#34d399"
        stroke-opacity="0.5"/>

  <text x="555" y="610"
        font-family="system-ui, sans-serif"
        font-size="14"
        font-weight="700"
        fill="#ffffff"
        text-anchor="middle">
    VGG19
  </text>

  <!-- Inception -->
  <rect x="655" y="580"
        width="150" height="48"
        rx="8"
        fill="#111827"
        stroke="#34d399"
        stroke-opacity="0.5"/>

  <text x="730" y="610"
        font-family="system-ui, sans-serif"
        font-size="14"
        font-weight="700"
        fill="#ffffff"
        text-anchor="middle">
    INCEPTION
  </text>

  <!-- Xception -->
  <rect x="830" y="580"
        width="150" height="48"
        rx="8"
        fill="#0f2921"
        stroke="#34d399"
        stroke-width="2"/>

  <text x="905" y="610"
        font-family="system-ui, sans-serif"
        font-size="14"
        font-weight="700"
        fill="#34d399"
        text-anchor="middle">
    XCEPTION
  </text>

  <!-- Arrows -->
  <g stroke="#52525b" stroke-width="2">
    <line x1="280" y1="604" x2="305" y2="604"/>
    <line x1="455" y1="604" x2="480" y2="604"/>
    <line x1="630" y1="604" x2="655" y2="604"/>
    <line x1="805" y1="604" x2="830" y2="604"/>
  </g>

  <!-- Main Title -->
  <text x="600" y="675"
        font-family="system-ui, sans-serif"
        font-size="30"
        font-weight="700"
        fill="#ffffff"
        text-anchor="middle"
        letter-spacing="2">
    MRI BRAIN TUMOR DETECTION
  </text>

  <!-- Subtitle -->
  <text x="600" y="705"
        font-family="system-ui, sans-serif"
        font-size="15"
        fill="#a1a1aa"
        text-anchor="middle">
    Pre-trained CNN Models • Transfer Learning • Computer Vision
  </text>

  <!-- Result -->
  <rect x="425" y="730"
        width="350"
        height="42"
        rx="21"
        fill="#0f2921"
        stroke="#34d399"
        stroke-opacity="0.5"/>

  <text x="600" y="756"
        font-family="monospace"
        font-size="12"
        fill="#34d399"
        text-anchor="middle"
        letter-spacing="1.5">
    XCEPTION • BEST MODEL • ~95% ACCURACY
  </text>

</svg>
